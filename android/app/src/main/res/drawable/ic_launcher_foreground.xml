<?xml version="1.0" encoding="utf-8"?>
<!-- NEXUS TAP adaptive-icon foreground: a neon tap target.
     108dp canvas; everything that must stay visible sits inside the centred
     66dp safe zone, since launchers mask the outer edges. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outer pulse ring -->
    <path
        android:pathData="M54,25.5 A28.5,28.5 0 1,1 53.99,25.5 Z"
        android:fillColor="#00000000"
        android:strokeColor="#7c3aed"
        android:strokeAlpha="0.55"
        android:strokeWidth="3" />

    <!-- main ring -->
    <path
        android:pathData="M54,32 A22,22 0 1,1 53.99,32 Z"
        android:fillColor="#00000000"
        android:strokeColor="#a78bfa"
        android:strokeWidth="5.5" />

    <!-- inner ring -->
    <path
        android:pathData="M54,42 A12,12 0 1,1 53.99,42 Z"
        android:fillColor="#00000000"
        android:strokeColor="#22d3ee"
        android:strokeWidth="4" />

    <!-- core -->
    <path
        android:pathData="M54,48 A6,6 0 1,1 53.99,48 Z"
        android:fillColor="#f0abfc" />
</vector>
