<?xml version="1.0" encoding="utf-8"?>
<!-- Backup / device-transfer rules for Android 12 and above.
     Same idea as backup_rules.xml: player progress (WebView localStorage) is
     restored on a new device, caches are not. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/Default/Cache" />
        <exclude domain="root" path="app_webview/Default/Code Cache" />
        <exclude domain="root" path="app_webview/Default/Service Worker/CacheStorage" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/Default/Cache" />
        <exclude domain="root" path="app_webview/Default/Code Cache" />
        <exclude domain="root" path="app_webview/Default/Service Worker/CacheStorage" />
    </device-transfer>
</data-extraction-rules>
